# Copiar como apps/api/.env. Los valores coinciden con infra/docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=evenhub
RABBITMQ_URL=amqp://user:password@localhost:5672
PORT=3000
# Generar un valor propio (por ejemplo: openssl rand -base64 48) y no versionarlo.
# Si queda vacío fuera de producción, la API usa un secreto aleatorio por proceso.
JWT_SECRET=
# Opcional: WSDL del servicio de pagos legado (si no responde se usa el mock).
# PAYMENTS_WSDL_URL=
